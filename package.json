{
    "name": "files-api",
    "version": "1.0.0",
    "description": "",
    "main": "src/main.js",
    "author": "sararchh",
    "license": "ISC",
    "keywords": [
        "back-end",
        "typescript",
        "express",
        "nodejs",
        "mariadb",
        "testes",
        "logica",
        "simplicidade",
        "solid",
        "automacao",
        "build",
        "coverage",
        "api-design",
        "git"
    ],
    "engines": {
        "node": ">=20.16.0 <=22.13.1"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "scripts": {
        "dev": "cross-env NODE_ENV=development && tsx watch src/main.ts",
        "start:dev": "cross-env NODE_ENV=development node dist/main.js",
        "start": "rm -rf dist && yarn build && node dist/main.js",
        "start:prod": "cross-env NODE_ENV=production && tsx watch src/main.ts",
        "dev:load-envs": "dotenv -e .env.development",
        "db:migrate": "yarn sequelize db:migrate",
        "db:seed": "yarn sequelize db:seed:all",
        "build": "rm -rf dist && tsup --config tsup.config.ts && yarn copy:templates",
        "copy:templates": "copyfiles -u 1 src/templates/**/* dist",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "lint:check": "eslint .",
        "lint:fix": "eslint --fix .",
        "prepare": "husky install",
        "pre-commit": "yarn lint:fix"
    },
    "lint-staged": {
        "*.{js,ts,json,css,md}": [
            "prettier --write",
            "git add"
        ]
    },
    "dependencies": {
        "body-parser": "1.20.3",
        "cors": "2.8.5",
        "cross-env": "7.0.3",
        "dotenv": "16.4.5",
        "ejs": "3.1.10",
        "express": "4.19.2",
        "http": "0.0.1-security",
        "http-status": "1.7.4",
        "multer": "2.0.2",
        "mysql2": "3.10.3",
        "reflect-metadata": "0.2.2",
        "sequelize": "6.37.3",
        "sequelize-typescript": "2.1.6",
        "zod": "4.0.14"
    },
    "devDependencies": {
        "@commitlint/cli": "19.6.1",
        "@commitlint/config-conventional": "19.6.0",
        "@types/body-parser": "1.19.5",
        "@types/cors": "2.8.17",
        "@types/express": "4.17.21",
        "@types/node": "20.14.11",
        "commitlint": "19.6.1",
        "copyfiles": "2.4.1",
        "eslint": "9.19.0",
        "eslint-config-prettier": "10.0.1",
        "eslint-plugin-prettier": "5.2.3",
        "globals": "15.14.0",
        "husky": "9.1.7",
        "lint-staged": "15.4.3",
        "prettier": "3.4.2",
        "sequelize-cli": "6.6.2",
        "tsup": "8.2.1",
        "tsx": "4.16.2",
        "typescript": "5.5.3",
        "typescript-eslint": "8.22.0"
    }
}
